# Environment files & server markers
.env
.env.*
**/.env
**/.env.*
.client
.client.*

# Node / package managers
node_modules/
**/node_modules/

# Build output
/dist/
/build/
**/dist/
**/build/
frontend/store/
frontend/shop/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Exclude old dashboard directories from git tracking & VPS copy
dash_old/
# old-dashboard/
PIG/

# Backups & Local Data
backups/
**/backups/
/data/
backend/data/
exports/
*.gz
*.archive
*.dump
*.tar

# Client-specific configs and secrets (Only demo and template tracked in upstream)
configs/*.json
!configs/demo.json
!configs/client.template.json
!configs/surokkha.json

.agents
*.bundle
.wrangler/
**/.wrangler/

# Unignore examples and site env configs
!**/.env.example
!frontend/.env.store
!frontend/.env.shop
!frontend/src/data/