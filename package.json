{
  "name": "surokkha-platform",
  "version": "1.0.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:backend:storefront": "npm run dev:storefront --prefix backend",
    "dev:backend:dashboard": "npm run dev:dashboard --prefix backend",
    "dev:dashboard": "npm run dev --prefix dashboard",
    "build": "npm run build:frontend && npm run build:dashboard",
    "build:frontend": "npm run build:all --prefix frontend",
    "build:store": "npm run build:store --prefix frontend",
    "build:shop": "npm run build:shop --prefix frontend",
    "build:dashboard": "node scripts/sync-config.js surokkha && npm run build --prefix dashboard",
    "sync-config": "node scripts/sync-config.js surokkha",
    "deploy": "node backend/scripts/deploy/all.js",
    "deploy:frontend": "node backend/scripts/deploy/frontend.js",
    "deploy:dashboard": "node backend/scripts/deploy/dashboard.js",
    "deploy:backend": "node backend/scripts/deploy/backend.js"
  }
}
