    "sizeChart": false,
    "webmail": true,
    "inStoreOrder": false,
    "customOrders": true
  },
  "stockManagement": {
    "simpleProduct": true,
    "variableProduct": true
  },
  "reports": {
    "enableInStoreFilter": false,
    "enableCustomOrderFilter": true,
