        "slots": [
          { "key": "slider-1", "label": "Slide 1", "filename": "slider-1.webp", "recommendedSize": "1920x650" },
          { "key": "slider-2", "label": "Slide 2", "filename": "slider-2.webp", "recommendedSize": "1920x650" }
        ]
      },
      {
        "id": "promo-banners",
