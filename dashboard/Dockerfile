# Build Stage
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .

ARG VITE_API_BASE_URL=https://api.example.com
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

ARG VITE_CLIENT=demo
ENV VITE_CLIENT=$VITE_CLIENT

# Client identity (set from the client's root .env, never from tracked files)
ARG VITE_CLIENT_ID=
ENV VITE_CLIENT_ID=$VITE_CLIENT_ID
ARG VITE_ORDER_PREFIX=
ENV VITE_ORDER_PREFIX=$VITE_ORDER_PREFIX
ARG VITE_BRAND_NAME=
ENV VITE_BRAND_NAME=$VITE_BRAND_NAME
ARG VITE_CLIENT_DOMAIN=
ENV VITE_CLIENT_DOMAIN=$VITE_CLIENT_DOMAIN
ARG VITE_SUPPORT_EMAIL=
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ARG VITE_CLIENT_PHONE=
ENV VITE_CLIENT_PHONE=$VITE_CLIENT_PHONE
ARG VITE_SUPPORT_PHONE=
ENV VITE_SUPPORT_PHONE=$VITE_SUPPORT_PHONE
ARG VITE_WHATSAPP_NUMBER=
ENV VITE_WHATSAPP_NUMBER=$VITE_WHATSAPP_NUMBER
ARG VITE_CLIENT_ADDRESS=
ENV VITE_CLIENT_ADDRESS=$VITE_CLIENT_ADDRESS
ARG VITE_LOGO_URL=
ENV VITE_LOGO_URL=$VITE_LOGO_URL
ARG VITE_DASHBOARD_URL=
ENV VITE_DASHBOARD_URL=$VITE_DASHBOARD_URL
ARG VITE_STOREFRONT_URL=
ENV VITE_STOREFRONT_URL=$VITE_STOREFRONT_URL
ARG VITE_CLIENT_CONFIG_JSON=
ENV VITE_CLIENT_CONFIG_JSON=$VITE_CLIENT_CONFIG_JSON

RUN npm run build

# Production Stage (Nginx)
FROM nginx:alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
EXPOSE 8005

CMD ["nginx", "-g", "daemon off;"]
