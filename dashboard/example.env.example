# Copy to dashboard/.env (local dev) or the repo-root .env (docker build args).
# Client identity lives ONLY here so template pulls can't overwrite it.
VITE_API_BASE_URL=https://api.yourbrand.com
VITE_CLIENT=yourbrand
VITE_CLIENT_ID=01
VITE_ORDER_PREFIX=YB
VITE_BRAND_NAME=Your Brand
VITE_CLIENT_DOMAIN=yourbrand.com
VITE_SUPPORT_EMAIL=info@yourbrand.com
VITE_CLIENT_PHONE=+8801XXXXXXXXX
VITE_SUPPORT_PHONE=+8801XXXXXXXXX
VITE_WHATSAPP_NUMBER=+8801XXXXXXXXX
VITE_CLIENT_ADDRESS=Dhaka, Bangladesh
VITE_LOGO_URL=
VITE_DASHBOARD_URL=https://dashboard.yourbrand.com
VITE_STOREFRONT_URL=https://yourbrand.com
# Optional policies/features overrides (single-line JSON)
# VITE_CLIENT_CONFIG_JSON={"features":{"season":false}}
