NODE_ENV=development
PORT=5092
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ecommerce-db
MONGODB_DB_NAME=ecommerce-db

# JWT / Security Tokens
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_at_least_20_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_MS=2592000000

# White-Label Domain Routing & CORS Setup (Comma-separated lists)
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8005,http://localhost:3000,http://localhost:4001,http://localhost:4002,http://localhost:5173
FRONTEND_DOMAIN_KEYWORDS=localhost,example.com
DASHBOARD_DOMAIN_KEYWORDS=dashboard,localhost:8005,localhost:5173

# ── Client identity ─────────────────────────────────────────────
# Lives ONLY here (never in tracked JSON), so pulling the template repo
# can't overwrite it. With CLIENT_NAME != demo, the demo brand is never used.
CLIENT_NAME=yourbrand
CLIENT_ID=01
ORDER_PREFIX=YB
BRAND_NAME=Your Brand
CLIENT_DOMAIN=yourbrand.com
SUPPORT_EMAIL=info@yourbrand.com
CLIENT_PHONE=+8801XXXXXXXXX
SUPPORT_PHONE=+8801XXXXXXXXX
WHATSAPP_NUMBER=+8801XXXXXXXXX
CLIENT_ADDRESS=Dhaka, Bangladesh
LOGO_URL=
API_BASE_URL=https://api.yourbrand.com
DASHBOARD_URL=https://dashboard.yourbrand.com
STOREFRONT_URL=https://yourbrand.com
SMTP_FROM_NAME=Your Brand
# Optional: policies/features overrides, deep-merged over the template defaults
# CLIENT_CONFIG_JSON={"features":{"season":false},"policies":{"stock":{"lowStockThreshold":3}}}
# Optional: full client JSON file (or a directory containing client.json) outside the repo
# CLIENT_CONFIG_PATH=/opt/yourbrand/configs/client.json
TURNSTILE_LOGIN_DISABLED=
